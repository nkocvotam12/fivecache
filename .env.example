# ==============================================================================
# FiveCache Environment Variables & 200Lab Stack Configuration
# ==============================================================================

# 1. DATABASE CONFIGURATION (PostgreSQL / Supabase / Neon)
# The application requires a valid PostgreSQL connection string in production.
# If not configured, safe in-memory fallback is automatically used.
DATABASE_URL="postgresql://user:password@host:5432/fivecache?sslmode=require"
POSTGRES_PRISMA_URL="postgresql://user:password@host:5432/fivecache?sslmode=require"

# 2. CLOUDFLARE D1 DATABASE (Edge Database option)
CLOUDFLARE_ACCOUNT_ID="your_cloudflare_account_id"
CLOUDFLARE_D1_DATABASE_ID="your_cloudflare_d1_database_id"
CLOUDFLARE_D1_API_TOKEN="your_cloudflare_api_token"

# 3. AUTHENTICATION (Better Auth / NextAuth / JWT)
NEXTAUTH_URL="https://fivecachesite.vercel.app"
NEXTAUTH_SECRET="fivecache_jwt_secret_key_change_me_in_prod"

# 4. EMAIL SENDING (Resend REST API)
# Get your API key from https://resend.com
RESEND_API_KEY="re_1234567890abcdef"
RESEND_FROM_EMAIL="FiveCache <billing@fivecache.site>"

# 5. CLOUDFLARE R2 OBJECT STORAGE (S3-compatible, Zero Egress Fees)
# Store FiveM asset streams (.ytd, .yft, .rpf, .meta)
R2_ACCOUNT_ID="your_cloudflare_account_id"
R2_ACCESS_KEY_ID="your_r2_access_key_id"
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
R2_BUCKET_NAME="fivecache-assets"
R2_PUBLIC_DOMAIN="https://pub-r2.fivecache.site"

# 6. SEPAY VIETQR AUTOMATED PAYMENT GATEWAY
# Get credentials and configure webhook from https://my.sepay.vn
SEPAY_BANK_NAME="MBBank"
SEPAY_ACCOUNT_NUMBER="0987654321"
SEPAY_ACCOUNT_NAME="FIVECACHE VIETNAM"
SEPAY_API_KEY="sepay_api_key_here"
SEPAY_WEBHOOK_TOKEN="fivecache_secret_token"

# 7. FIVEM SERVER CONFIGURATION
DEFAULT_FIVEM_HOST="51.79.138.64"
DEFAULT_FIVEM_PORT="30120"
DEFAULT_FIVEM_DOMAIN="play.danchoixom.com"
