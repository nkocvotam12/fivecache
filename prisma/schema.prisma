// FiveCache - FiveM CDN caching service
// Database schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String        @id @default(cuid())
  email         String        @unique
  passwordHash  String
  name          String?
  emailVerified DateTime?
  plan          String        @default("free") // free, hobby, pro_plus, custom_evarose
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  servers       CacheServer[]
  sessions      Session[]
  tokens        VerificationToken[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model VerificationToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  type      String // 'email_verification' | 'password_reset'
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CacheServer {
  id            String         @id @default(cuid())
  userId        String
  serverId      String         @unique // SERVER_ID portion of URL like abc123
  name          String
  serverIp      String?
  serverPort    Int?
  domain        String // abc123.fivecache.site
  cacheUrl      String // https://abc123.fivecache.site/files
  plan          String         @default("pro_plus")
  blocked       Boolean        @default(false)
  resetDate     DateTime?
  // Aggregate stats
  totalRequests Int            @default(0)
  bandwidthUsed Float          @default(0) // bytes
  storageUsed   Float          @default(0) // bytes
  cacheHitRate  Float          @default(0)
  filesCached   Int            @default(0)
  // HTTP status code distribution
  status2xx     Int            @default(0)
  status3xx     Int            @default(0)
  status4xx     Int            @default(0)
  status5xx     Int            @default(0)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  monthlyStats  MonthlyStat[]
  topCountries  TopCountry[]
  topFiles      TopFile[]
}

model MonthlyStat {
  id        String      @id @default(cuid())
  serverId  String
  month     DateTime // first day of month
  requests  Int        @default(0)
  bandwidth Float      @default(0) // bytes
  hit2xx    Int        @default(0)
  hit3xx    Int        @default(0)
  hit4xx    Int        @default(0)
  hit5xx    Int        @default(0)
  hitRate   Float      @default(0)
  server    CacheServer @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@unique([serverId, month])
}

model TopCountry {
  id        String      @id @default(cuid())
  serverId  String
  country   String
  code      String // ISO 2-letter code
  requests  Int        @default(0)
  server    CacheServer @relation(fields: [serverId], references: [id], onDelete: Cascade)
}

model TopFile {
  id        String      @id @default(cuid())
  serverId  String
  file      String
  requests  Int        @default(0)
  server    CacheServer @relation(fields: [serverId], references: [id], onDelete: Cascade)
}

model BlogPost {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  category  String
  date      DateTime
  readTime  Int // minutes
  excerpt   String
  content   String // Markdown
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


