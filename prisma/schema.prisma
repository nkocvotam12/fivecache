// FiveCache - FiveM CDN caching service
// Database schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String        @id @default(cuid())
  email         String        @unique
  passwordHash  String
  name          String?
  emailVerified DateTime?
  plan          String        @default("free") // free, hobby, pro_plus, custom_evarose
  // Shield CDN billing balance (VND)
  balanceVnd    Int           @default(0)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  servers       CacheServer[]
  shields       ShieldServer[]
  sessions      Session[]
  tokens        VerificationToken[]
}

// ===== Shield CDN (anti-dump) =====
model ShieldServer {
  id              String   @id @default(cuid())
  userId          String
  code            String   @unique // subdomain portion e.g. "sharkcity"
  name            String   // display name "SharkCITY"
  originHost      String   // IP or domain of FXServer
  originPort      Int      // 30120
  protocol        String   @default("http") // http or https
  domain          String   // <code>.fivecachesite.vercel.app
  cacheUrl        String   // https://<code>.fivecachesite.vercel.app/files
  adhesiveKey     String   // 32-byte hex random, used in `set adhesive_cdnKey`
  status          String   @default("active") // active | suspended | cancelled
  pricePerMonth   Int      @default(299000) // VND
  expiresAt       DateTime // createdAt + 30 days
  lastBilledAt    DateTime @default(now())
  autoRenew       Boolean  @default(true)
  // Aggregate stats
  totalRequests   Int      @default(0)
  blockedRequests Int      @default(0)
  bandwidthServed Float    @default(0) // bytes
  uniquePlayers   Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokens          ShieldToken[]
  logs            ShieldAccessLog[]
}

model ShieldToken {
  id            String       @id @default(cuid())
  shieldId      String
  token         String       @unique // short-lived bearer token issued to a player session
  playerLicense String       // FiveM player license (hex)
  playerIp      String       // requester IP
  expiresAt     DateTime     // ~5 minutes TTL
  createdAt     DateTime     @default(now())
  shield        ShieldServer @relation(fields: [shieldId], references: [id], onDelete: Cascade)

  @@index([shieldId, expiresAt])
}

model ShieldAccessLog {
  id            String       @id @default(cuid())
  shieldId      String
  timestamp     DateTime     @default(now())
  playerIp      String?
  playerLicense String?
  filePath      String
  status        String       // 'allowed' | 'blocked'
  reason        String       // 'no_token' | 'invalid_token' | 'expired_token' | 'bad_user_agent' | 'invalid_hash' | 'shield_inactive' | 'ok'
  bytesServed   Int          @default(0)
  shield        ShieldServer @relation(fields: [shieldId], references: [id], onDelete: Cascade)
}

model BalanceTransaction {
  id        String   @id @default(cuid())
  userId    String
  amount    Int      // positive = top-up, negative = billing
  type      String   // 'topup' | 'shield_create' | 'shield_renew' | 'shield_cancel_refund'
  reference String?  // shield id or note
  createdAt DateTime @default(now())
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model VerificationToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  type      String // 'email_verification' | 'password_reset'
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CacheServer {
  id            String         @id @default(cuid())
  userId        String
  serverId      String         @unique // SERVER_ID portion of URL like abc123
  name          String
  serverIp      String?
  serverPort    Int?
  domain        String // abc123.fivecachesite.vercel.app
  cacheUrl      String // https://abc123.fivecachesite.vercel.app/files
  plan          String         @default("pro_plus")
  blocked       Boolean        @default(false)
  resetDate     DateTime?
  // Aggregate stats
  totalRequests Int            @default(0)
  bandwidthUsed Float          @default(0) // bytes
  storageUsed   Float          @default(0) // bytes
  cacheHitRate  Float          @default(0)
  filesCached   Int            @default(0)
  // HTTP status code distribution
  status2xx     Int            @default(0)
  status3xx     Int            @default(0)
  status4xx     Int            @default(0)
  status5xx     Int            @default(0)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  monthlyStats  MonthlyStat[]
  topCountries  TopCountry[]
  topFiles      TopFile[]
}

model MonthlyStat {
  id        String      @id @default(cuid())
  serverId  String
  month     DateTime // first day of month
  requests  Int        @default(0)
  bandwidth Float      @default(0) // bytes
  hit2xx    Int        @default(0)
  hit3xx    Int        @default(0)
  hit4xx    Int        @default(0)
  hit5xx    Int        @default(0)
  hitRate   Float      @default(0)
  server    CacheServer @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@unique([serverId, month])
}

model TopCountry {
  id        String      @id @default(cuid())
  serverId  String
  country   String
  code      String // ISO 2-letter code
  requests  Int        @default(0)
  server    CacheServer @relation(fields: [serverId], references: [id], onDelete: Cascade)
}

model TopFile {
  id        String      @id @default(cuid())
  serverId  String
  file      String
  requests  Int        @default(0)
  server    CacheServer @relation(fields: [serverId], references: [id], onDelete: Cascade)
}

model BlogPost {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  category  String
  date      DateTime
  readTime  Int // minutes
  excerpt   String
  content   String // Markdown
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


